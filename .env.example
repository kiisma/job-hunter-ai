# Copy this file to .env and fill in the values.

# ── Required ──────────────────────────────────────────────────────────────────

# Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Telegram chat ID of the operator who receives confirmed orders.
# Send /start to @userinfobot to find your chat ID.
OPERATOR_CHAT_ID=123456789

# ── Optional (business logic) ─────────────────────────────────────────────────

# Shipping cost to Russia in EUR per kg (default: 15)
RUSSIA_SHIPPING_PER_KG=15

# Markup percentage added to product prices (default: 25)
MARKUP_PERCENT=25
